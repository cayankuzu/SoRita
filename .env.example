# Client-visible runtime config.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
EXPO_PUBLIC_SUPABASE_DELETE_USER_FUNCTION_NAME=delete-user
EXPO_PUBLIC_SUPABASE_MEDIA_ASSETS_FUNCTION_NAME=media-assets
EXPO_PUBLIC_SUPABASE_AUTH_GATEWAY_FUNCTION_NAME=auth-gateway
EXPO_PUBLIC_SUPABASE_MODERATION_REPORTS_FUNCTION_NAME=moderation-reports
EXPO_PUBLIC_SUPABASE_MAPS_FUNCTION_NAME=maps-geocoding
# Keep direct mode until an approved gateway deployment is ready for this binary.
EXPO_PUBLIC_EDGE_CUTOVER_MODE=direct
# Required and HTTPS-only when EXPO_PUBLIC_EDGE_CUTOVER_MODE=gateway.
# Do not infer this value from the Supabase URL or a placeholder root domain.
EXPO_PUBLIC_EDGE_API_URL=
# development | preview | production; EAS_BUILD_PROFILE is used when this is omitted.
EXPO_PUBLIC_RELEASE_ENVIRONMENT=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# Optional platform-specific keys if you want separate restrictions.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=your_android_google_maps_api_key
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=your_ios_google_maps_api_key
# Optional public key restricted to the Google Static Maps API. Geocoding and
# Places service keys must remain server-side.
EXPO_PUBLIC_GOOGLE_MAPS_STATIC_API_KEY=your_public_static_maps_api_key
EXPO_PUBLIC_SYSTEM_NOTIFICATION_FCM_TOPIC=system-all-users-v1
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
EXPO_PUBLIC_EXPO_PROJECT_ID=your_expo_project_id
EXPO_OWNER=your_expo_username
EXPO_PUBLIC_SENTRY_DSN=https://your-public-sentry-dsn
EXPO_PUBLIC_FACEBOOK_APP_ID=

# Local and server-only secrets. Keep real values in the encrypted continuity backup, not in Git.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
GOOGLE_MAPS_SERVICES_API_KEY=your_server_side_google_maps_services_api_key
AUTH_REDIRECT_ALLOWED_ORIGINS=sorita://auth/callback,sorita://reset-password
# Server-only counterpart of the Worker's ORIGIN_HMAC_SECRET. Use the same
# randomly generated value (at least 32 bytes) in protected provider storage.
CLOUDFLARE_ORIGIN_HMAC_SECRET=your_shared_cloudflare_origin_hmac_secret
# Keep false through dual/direct compatibility. Set true only after the staged
# gateway cutover and retirement of every supported direct-mode binary.
CLOUDFLARE_ORIGIN_SIGNATURE_REQUIRED=false
# Exact browser origins only; native requests without an Origin header do not
# need to be added. Never use `*` for authenticated moderation intake.
MODERATION_REPORTS_ALLOWED_ORIGINS=https://cayankuzu.github.io
SYSTEM_BROADCAST_ADMIN_TOKEN=your_system_broadcast_admin_token
REPORTS_EMAIL_FROM=reports@example.com
REPORTS_EMAIL_TO=moderation@example.com
RESEND_API_KEY=your_resend_api_key
BREVO_API_KEY=your_brevo_api_key

SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project
SENTRY_URL=https://sentry.io/
SENTRY_AUTH_TOKEN=your_sentry_auth_token
