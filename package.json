{
  "name": "sorita",
  "private": true,
  "version": "1.0.90",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "android": "concurrently --kill-others-on-fail -n EXPO,LOGS,APP -c green,magenta,yellow \"npm run mobile:live\" \"npm run logs:android\" \"npm run open:android\"",
    "android:debug": "npm run android",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:SENTRY_DISABLE_AUTO_UPLOAD='true'; Set-Location android; .\\gradlew.bat :app:assembleStandalone --console=plain\"",
    "android:rebuild": "concurrently --kill-others-on-fail -n EXPO,NATIVE,LOGS -c green,blue,magenta \"npm run mobile:live\" \"npm run run:android\" \"npm run logs:android\"",
    "android:profile:verify": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Set-Location android; .\\gradlew.bat :app:mergeReleaseArtProfile --console=plain\"",
    "architecture:check": "node utils/guards/check-architecture-boundaries.cjs",
    "dead-code:check": "knip --include files,dependencies,unlisted,binaries --no-progress",
    "e2e:evidence": "node utils/guards/check-critical-flow-evidence.mjs",
    "check": "npm run lint && npm run typecheck && npm run test",
    "check:release": "npm run expo:check && npm run lint && npm run typecheck && npm run dead-code:check && npm run e2e:evidence && npm run performance:test && npm run security:audit:prod && npm run security:licenses && npm run security:provenance && npm run test && npm run security:verify && npm run test:coverage",
    "clean:metro": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"if (Test-Path .expo) { Remove-Item .expo -Recurse -Force }; if (Test-Path \\\"$env:LOCALAPPDATA\\\\Temp\\\\metro-cache\\\") { Remove-Item \\\"$env:LOCALAPPDATA\\\\Temp\\\\metro-cache\\\" -Recurse -Force }\"",
    "expo:android": "npm run mobile:live",
    "expo:check": "npx expo install --check && npx expo-doctor",
    "expo:start": "npm run mobile:live",
    "logs:android": "node utils/android-logcat.mjs --clear",
    "logs:android:all": "node utils/android-logcat.mjs --clear --all",
    "load:test": "k6 run tests/load/read-models.k6.js",
    "lint": "eslint App.tsx app.config.ts index.js src supabase/functions utils --max-warnings=0 && npm run architecture:check && npm run ui-copy:check",
    "mobile:live": "node utils/android-metro.mjs",
    "notify:broadcast": "node utils/send-system-notification.mjs",
    "open:android": "node utils/android-launch-app.mjs",
    "performance:test": "vitest run src/mobile/app/shared/performance src/mobile/app/app-shell/startup src/mobile/app/platform/network",
    "start": "expo start",
    "run:android": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$sdk = if ($env:ANDROID_HOME) { $env:ANDROID_HOME } elseif ($env:ANDROID_SDK_ROOT) { $env:ANDROID_SDK_ROOT } else { Join-Path $env:LOCALAPPDATA 'Android\\Sdk' }; $platformTools = Join-Path $sdk 'platform-tools'; if (Test-Path $platformTools) { $env:Path = \\\"$platformTools;$env:Path\\\" }; expo run:android --no-bundler\"",
    "security:audit:prod": "npm audit --omit=dev --audit-level=high",
    "security:licenses": "node utils/guards/check-production-licenses.mjs",
    "security:provenance": "npm audit signatures",
    "security:verify": "vitest run src/mobile/app/platform/supabase/__tests__/media.test.ts supabase/functions/_shared/requestSecurity.test.ts supabase/functions/auth-gateway/handler.test.ts supabase/functions/delete-user/handler.test.ts supabase/functions/maps-geocoding/handler.test.ts supabase/functions/media-assets/handler.test.ts",
    "test": "node utils/run-tests.mjs",
    "test:app-shell-data": "vitest run src/mobile/app/app-shell src/mobile/app/data",
    "test:coverage": "node utils/run-coverage.mjs",
    "test:features": "node utils/run-feature-tests.mjs",
    "test:feature:auth": "vitest run src/mobile/app/features/auth",
    "test:feature:explore": "vitest run src/mobile/app/features/explore",
    "test:feature:home": "vitest run src/mobile/app/features/home",
    "test:feature:lists": "vitest run src/mobile/app/features/lists",
    "test:feature:map": "vitest run src/mobile/app/features/map",
    "test:feature:notifications": "vitest run src/mobile/app/features/notifications",
    "test:feature:places": "vitest run src/mobile/app/features/places",
    "test:feature:profile": "vitest run src/mobile/app/features/profile",
    "test:feature:settings": "vitest run src/mobile/app/features/settings",
    "test:feature:social": "vitest run src/mobile/app/features/social",
    "test:platform-shared": "vitest run src/mobile/app/platform src/mobile/app/shared src/shared supabase/functions",
    "typecheck": "npm run typecheck:app && npm run typecheck:tests",
    "typecheck:app": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "ui-copy:check": "node utils/guards/check-ui-copy.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-firebase/app": "^25.1.0",
    "@react-native-firebase/messaging": "^25.1.0",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.9.26",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.103.0",
    "@tanstack/react-query": "^5.97.0",
    "concurrently": "^9.2.3",
    "dotenv": "^17.4.1",
    "expo": "~55.0.28",
    "expo-build-properties": "~55.0.13",
    "expo-camera": "~55.0.21",
    "expo-clipboard": "~55.0.15",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.17",
    "expo-device": "~55.0.19",
    "expo-file-system": "~55.0.24",
    "expo-haptics": "~55.0.16",
    "expo-image": "~55.0.11",
    "expo-image-manipulator": "~55.0.19",
    "expo-image-picker": "~55.0.22",
    "expo-linear-gradient": "~55.0.16",
    "expo-linking": "~55.0.16",
    "expo-location": "~55.1.12",
    "expo-media-library": "~55.0.19",
    "expo-notifications": "~55.0.25",
    "expo-secure-store": "~55.0.16",
    "expo-splash-screen": "~55.0.23",
    "expo-system-ui": "~55.0.20",
    "expo-updates": "~55.0.26",
    "expo-video": "~55.0.19",
    "expo-video-thumbnails": "~55.0.17",
    "lucide-react-native": "^1.8.0",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-maps": "1.27.2",
    "react-native-pager-view": "8.0.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-webview": "13.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitest/coverage-v8": "^4.1.4",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "knip": "^6.27.0",
    "msw": "^2.13.3",
    "react-test-renderer": "^19.2.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@react-native/dev-middleware": {
      "ws": "7.5.11"
    },
    "@supabase/realtime-js": {
      "ws": "8.21.0"
    },
    "@xmldom/xmldom": "0.8.13",
    "@expo/cli": {
      "ws": "8.21.0"
    },
    "axios": "1.18.1",
    "form-data": "4.0.6",
    "joi": "18.2.3",
    "js-yaml": "3.15.0",
    "metro": {
      "ws": "7.5.11"
    },
    "react-native": {
      "ws": "7.5.11"
    },
    "react-devtools-core": {
      "ws": "7.5.11"
    },
    "uuid": "11.1.1",
    "vite": "6.4.3"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
