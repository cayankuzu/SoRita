{
  "name": "sorita",
  "private": true,
  "version": "1.0.102",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "android": "concurrently --kill-others-on-fail -n EXPO,LOGS,APP -c green,magenta,yellow \"npm run mobile:live\" \"npm run logs:android\" \"npm run open:android\"",
    "android:debug": "npm run android",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:SENTRY_DISABLE_AUTO_UPLOAD='true'; Set-Location android; .\\gradlew.bat :app:assembleStandalone --console=plain\"",
    "android:rebuild": "concurrently --kill-others-on-fail -n EXPO,NATIVE,LOGS -c green,blue,magenta \"npm run mobile:live\" \"npm run run:android\" \"npm run logs:android\"",
    "android:profile:verify": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Set-Location android; .\\gradlew.bat :app:mergeReleaseArtProfile --console=plain\"",
    "android:profile:generate": "node utils/android-benchmark.mjs generate",
    "android:performance:test": "node utils/android-benchmark.mjs measure",
    "accessibility:check": "node utils/guards/check-pressable-accessibility.mjs",
    "architecture:check": "node utils/guards/check-architecture-boundaries.cjs",
    "bundle:android:check": "npm run security:assets && npx expo export --platform android --output-dir .expo/bundle-budget --clear && node utils/guards/check-bundle-size.mjs .expo/bundle-budget",
    "dead-code:check": "node utils/guards/check-knip-exceptions.mjs && knip --include files,dependencies,unlisted,binaries --no-progress --no-config-hints",
    "docs-tracked:check": "node utils/guards/check-docs-tracked.mjs",
    "deployment-workflows:test": "node --test utils/guards/__tests__/deployment-workflows.test.mjs utils/guards/__tests__/eas-credential-portability.test.mjs utils/guards/__tests__/media-upload-sweeper-workflow.test.mjs",
    "docker:build": "docker compose -f infra/docker/compose.yaml build maps-mock",
    "docker:clean": "node infra/docker/scripts/cleanup.mjs --volumes --confirm=DELETE_TEST_VOLUMES",
    "docker:config": "node infra/docker/scripts/run-test-profile.mjs --config-only",
    "docker:db-tools": "docker compose -f infra/docker/compose.yaml --profile db-tools run --rm db-tools",
    "docker:down": "node infra/docker/scripts/cleanup.mjs",
    "docker:load": "npm run docker:load:smoke",
    "docker:load:smoke": "node infra/docker/scripts/run-load-profile.mjs",
    "docker:load:staged": "node infra/docker/scripts/run-staged-load-profile.mjs",
    "docker:quality": "node infra/docker/scripts/run-quality-profile.mjs",
    "docker:resilience": "node infra/docker/scripts/run-resilience-profile.mjs",
    "docker:security": "node infra/docker/scripts/run-security-profile.mjs",
    "docker:supabase:restore": "node infra/docker/scripts/run-supabase-validation.mjs --phase restore",
    "docker:supabase:start": "node infra/docker/scripts/run-supabase-validation.mjs --phase start",
    "docker:supabase:test": "node infra/docker/scripts/run-supabase-validation.mjs --phase test",
    "docker:supabase:verify": "node infra/docker/scripts/run-supabase-validation.mjs --phase all",
    "docker:test": "node infra/docker/scripts/run-test-profile.mjs",
    "docker:up:test": "node infra/docker/scripts/run-test-profile.mjs --up-only",
    "docker:verify": "node infra/docker/scripts/run-verification.mjs",
    "docker:worker": "node infra/docker/scripts/run-test-profile.mjs --skip-database",
    "e2e:evidence": "node utils/guards/check-critical-flow-evidence.mjs",
    "e2e:device:guest": "maestro test e2e/maestro/auth-guest.yaml",
    "e2e:device:dev-catalog": "maestro test e2e/maestro/ui-catalog.yaml",
    "e2e:device:small": "powershell -NoProfile -ExecutionPolicy Bypass -File utils/run-small-screen-maestro.ps1",
    "eas:credentials:check": "node utils/guards/check-eas-credential-portability.mjs",
    "check": "npm run lint && npm run typecheck && npm run test",
    "check:release": "npm run expo:check && npm run lint && npm run feature-surface:check && npm run release-scorecard:check && npm run ota:classifier:test && npm run deployment-workflows:test && npm run release-evidence:test && npm run ops:test && npm run typecheck && npm run dead-code:check && npm run e2e:evidence && npm run performance:test && npm run security:audit:prod && npm run security:licenses && npm run security:provenance && npm run test && npm run security:verify && npm run test:coverage",
    "clean:metro": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"if (Test-Path .expo) { Remove-Item .expo -Recurse -Force }; if (Test-Path \\\"$env:LOCALAPPDATA\\\\Temp\\\\metro-cache\\\") { Remove-Item \\\"$env:LOCALAPPDATA\\\\Temp\\\\metro-cache\\\" -Recurse -Force }\"",
    "expo:android": "npm run mobile:live",
    "expo:check": "npx expo install --check && npx expo-doctor",
    "expo:start": "npm run mobile:live",
    "feature-surface:check": "node utils/guards/check-no-new-product-surface.mjs && node --test utils/guards/__tests__/check-no-new-product-surface.test.mjs",
    "knip-exceptions:check": "node utils/guards/check-knip-exceptions.mjs",
    "logs:android": "node utils/android-logcat.mjs --clear",
    "logs:android:all": "node utils/android-logcat.mjs --clear --all",
    "load:test": "k6 run tests/load/read-models.k6.js",
    "lint": "eslint App.tsx app.config.ts index.js src supabase/functions utils --max-warnings=0 && npm run architecture:check && npm run source-health:check && npm run text-encoding:check && npm run docs-tracked:check && npm run ui-copy:check && npm run ui-tokens:check && npm run accessibility:check && npm run feature-surface:check",
    "mobile:live": "node utils/android-metro.mjs",
    "notify:broadcast": "node utils/send-system-notification.mjs",
    "open:android": "node utils/android-launch-app.mjs",
    "ota:classify": "node utils/guards/classify-ota-change.mjs",
    "ota:classifier:test": "node --test utils/guards/__tests__/classify-ota-change.test.mjs utils/guards/__tests__/ota-workflows.test.mjs utils/eas/check-update-code-signing.test.mjs utils/eas/materialize-asc-api-key.test.mjs utils/eas/verify-build-evidence.test.mjs utils/eas/verify-production-ios-build.test.mjs",
    "ops:private-covers:audit": "node utils/ops/migrate-private-list-covers.mjs",
    "ops:private-covers:migrate": "node utils/ops/migrate-private-list-covers.mjs --apply",
    "ops:moderation": "node utils/ops/moderation-case.mjs",
    "ops:push-delivery:health": "node utils/ops/push-delivery-dlq.mjs health",
    "ops:push-delivery:requeue": "node utils/ops/push-delivery-dlq.mjs requeue",
    "ops:media-uploads:audit": "node utils/ops/sweep-media-upload-sessions.mjs",
    "ops:media-uploads:sweep": "node utils/ops/sweep-media-upload-sessions.mjs --apply",
    "ops:test": "node --test utils/ops/*.test.mjs",
    "performance:test": "vitest run src/mobile/app/shared/performance src/mobile/app/app-shell/startup src/mobile/app/platform/network",
    "release-evidence:create": "node utils/release-evidence/manifest.mjs create",
    "release-evidence:test": "node --test utils/release-evidence/*.test.mjs",
    "release-evidence:verify": "node utils/release-evidence/manifest.mjs verify",
    "release-scorecard:check": "node utils/guards/check-release-scorecard.mjs && node --test utils/guards/__tests__/release-scorecard.test.mjs",
    "start": "npm run mobile:live",
    "run:android": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$sdk = if ($env:ANDROID_HOME) { $env:ANDROID_HOME } elseif ($env:ANDROID_SDK_ROOT) { $env:ANDROID_SDK_ROOT } else { Join-Path $env:LOCALAPPDATA 'Android\\Sdk' }; $platformTools = Join-Path $sdk 'platform-tools'; if (Test-Path $platformTools) { $env:Path = \\\"$platformTools;$env:Path\\\" }; $metroPort = if ($env:SORITA_METRO_PORT) { $env:SORITA_METRO_PORT } elseif ($env:EXPO_PACKAGER_PORT) { $env:EXPO_PACKAGER_PORT } else { '18083' }; Set-Location android; .\\gradlew.bat :app:installDebug --console=plain \\\"-PreactNativeDevServerPort=$metroPort\\\"; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; Set-Location ..; node utils/android-launch-app.mjs\"",
    "security:assets": "node utils/guards/check-metro-assets.mjs",
    "security:audit:prod": "node utils/guards/check-production-audit.mjs",
    "security:audit:raw": "npm audit --omit=dev --audit-level=high",
    "security:licenses": "node utils/guards/check-production-licenses.mjs",
    "security:provenance": "npm audit signatures",
    "security:verify": "vitest run src/mobile/app/platform/supabase/__tests__/media.test.ts supabase/functions/_shared/originSecurity.test.ts supabase/functions/_shared/requestSecurity.test.ts supabase/functions/auth-gateway/handler.test.ts supabase/functions/delete-user/handler.test.ts supabase/functions/maps-geocoding/handler.test.ts supabase/functions/media-assets/handler.test.ts supabase/functions/moderation-reports/handler.test.ts",
    "source-health:check": "node utils/guards/check-source-health.mjs",
    "text-encoding:check": "node utils/guards/check-text-encoding.mjs && node --test utils/guards/__tests__/text-encoding.test.mjs",
    "test": "node utils/run-tests.mjs",
    "test:app-shell-data": "vitest run src/mobile/app/app-shell src/mobile/app/data",
    "test:coverage": "node utils/run-coverage.mjs",
    "test:features": "node utils/run-feature-tests.mjs",
    "test:feature:auth": "vitest run src/mobile/app/features/auth",
    "test:feature:explore": "vitest run src/mobile/app/features/explore",
    "test:feature:home": "vitest run src/mobile/app/features/home",
    "test:feature:lists": "vitest run src/mobile/app/features/lists",
    "test:feature:map": "vitest run src/mobile/app/features/map",
    "test:feature:notifications": "vitest run src/mobile/app/features/notifications",
    "test:feature:places": "vitest run src/mobile/app/features/places",
    "test:feature:profile": "vitest run src/mobile/app/features/profile",
    "test:feature:settings": "vitest run src/mobile/app/features/settings",
    "test:feature:social": "vitest run src/mobile/app/features/social",
    "test:platform-shared": "vitest run src/mobile/app/platform src/mobile/app/shared src/shared supabase/functions",
    "typecheck": "npm run typecheck:app && npm run typecheck:tests",
    "typecheck:app": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "ui-copy:check": "node utils/guards/check-ui-copy.mjs",
    "ui-tokens:check": "node utils/guards/check-ui-tokens.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
