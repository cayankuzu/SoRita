{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.2",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "android": "concurrently -k -n WEB,EXPO -c blue,green \"npm run dev\" \"npm run mobile:live\"",
    "android:debug": "concurrently -k -n WEB,EXPO,LOGS -c blue,green,magenta \"npm run dev\" \"npm run mobile:live\" \"npm run logs:android\"",
    "android:rebuild": "concurrently -k -n WEB,NATIVE,LOGS -c blue,green,magenta \"npm run dev\" \"npm run run:android\" \"npm run logs:android\"",
    "build": "vite build",
    "build:mobile-web": "vite build --config vite.mobile.config.ts",
    "build:native": "npm run build:mobile-web",
    "check": "npm run check:architecture && npm run typecheck && npm run build",
    "check:architecture": "node utils/guards/check-architecture-boundaries.cjs",
    "clean:metro": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"if (Test-Path .expo) { Remove-Item .expo -Recurse -Force }; if (Test-Path \\\"$env:LOCALAPPDATA\\\\Temp\\\\metro-cache\\\") { Remove-Item \\\"$env:LOCALAPPDATA\\\\Temp\\\\metro-cache\\\" -Recurse -Force }\"",
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "expo:android": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$sdk = if ($env:ANDROID_HOME) { $env:ANDROID_HOME } elseif ($env:ANDROID_SDK_ROOT) { $env:ANDROID_SDK_ROOT } else { Join-Path $env:LOCALAPPDATA 'Android\\Sdk' }; $platformTools = Join-Path $sdk 'platform-tools'; if (Test-Path $platformTools) { $env:Path = \\\"$platformTools;$env:Path\\\" }; expo start --clear --android\"",
    "expo:start": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$sdk = if ($env:ANDROID_HOME) { $env:ANDROID_HOME } elseif ($env:ANDROID_SDK_ROOT) { $env:ANDROID_SDK_ROOT } else { Join-Path $env:LOCALAPPDATA 'Android\\Sdk' }; $platformTools = Join-Path $sdk 'platform-tools'; if (Test-Path $platformTools) { $env:Path = \\\"$platformTools;$env:Path\\\" }; expo start --clear\"",
    "logs:android": "node utils/android-logcat.mjs --clear",
    "logs:android:all": "node utils/android-logcat.mjs --clear --all",
    "mobile:live": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"wait-on http://127.0.0.1:5173; $sdk = if ($env:ANDROID_HOME) { $env:ANDROID_HOME } elseif ($env:ANDROID_SDK_ROOT) { $env:ANDROID_SDK_ROOT } else { Join-Path $env:LOCALAPPDATA 'Android\\Sdk' }; $platformTools = Join-Path $sdk 'platform-tools'; if (Test-Path $platformTools) { $env:Path = \\\"$platformTools;$env:Path\\\" }; expo start --clear --android\"",
    "start": "expo start --clear",
    "run:android": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$sdk = if ($env:ANDROID_HOME) { $env:ANDROID_HOME } elseif ($env:ANDROID_SDK_ROOT) { $env:ANDROID_SDK_ROOT } else { Join-Path $env:LOCALAPPDATA 'Android\\Sdk' }; $platformTools = Join-Path $sdk 'platform-tools'; if (Test-Path $platformTools) { $env:Path = \\\"$platformTools;$env:Path\\\" }; expo run:android\"",
    "security:verify:internal": "vitest run src/mobile/app/platform/supabase/__tests__/media.test.ts supabase/functions/_shared/requestSecurity.test.ts supabase/functions/delete-user/handler.test.ts supabase/functions/media-assets/handler.test.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
