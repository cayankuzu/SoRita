    "expo-media-library": "~55.0.21",
    "expo-notifications": "~55.0.27",
    "expo-secure-store": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-system-ui": "~55.0.22",
    "expo-updates": "~55.0.30",
    "expo-video": "~55.0.21",
    "expo-video-thumbnails": "~55.0.19",
    "lucide-react-native": "^1.8.0",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-maps": "1.27.2",
    "react-native-pager-view": "9.0.3",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^3.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitest/coverage-v8": "^4.1.4",
    "ajv": "6.15.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "knip": "^6.27.0",
    "msw": "^2.13.3",
    "react-test-renderer": "^19.2.0",
