{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sorita-edge-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "vars": {
    "BUILD_SHA": "0000000000000000000000000000000000000000",
    "ENVIRONMENT": "development",
    "SUPABASE_URL": "https://replace-local-project-ref.supabase.co",
    "SUPABASE_JWT_AUDIENCE": "authenticated",
    "CORS_ALLOWLIST": "https://local.sorita.invalid",
    "ORIGIN_TIMEOUT_MS": "10000",
    "JWKS_TIMEOUT_MS": "3000",
    "LOG_SAMPLE_RATE": "1"
  },
  "secrets": {
    "required": [
      "SUPABASE_PUBLISHABLE_KEY",
      "ORIGIN_HMAC_SECRET",
      "IP_HASH_PEPPER"
    ]
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "86083000",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "86083001",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "env": {
    "development": {
      "name": "sorita-edge-development",
      "workers_dev": true,
      "vars": {
        "BUILD_SHA": "0000000000000000000000000000000000000000",
        "ENVIRONMENT": "development",
        "SUPABASE_URL": "https://replace-development-project-ref.supabase.co",
        "SUPABASE_JWT_AUDIENCE": "authenticated",
        "CORS_ALLOWLIST": "https://development.sorita.invalid",
        "ORIGIN_TIMEOUT_MS": "10000",
        "JWKS_TIMEOUT_MS": "3000",
        "LOG_SAMPLE_RATE": "1"
      },
      "secrets": {
        "required": [
          "SUPABASE_PUBLISHABLE_KEY",
          "ORIGIN_HMAC_SECRET",
          "IP_HASH_PEPPER"
        ]
      },
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "86083010",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "86083011",
          "simple": { "limit": 120, "period": 60 }
        }
      ]
    },
    "preview": {
      "name": "sorita-edge-preview",
      "workers_dev": true,
      "vars": {
        "BUILD_SHA": "0000000000000000000000000000000000000000",
        "ENVIRONMENT": "preview",
        "SUPABASE_URL": "https://replace-preview-project-ref.supabase.co",
        "SUPABASE_JWT_AUDIENCE": "authenticated",
        "CORS_ALLOWLIST": "https://preview.sorita.invalid",
        "ORIGIN_TIMEOUT_MS": "8000",
        "JWKS_TIMEOUT_MS": "2500",
        "LOG_SAMPLE_RATE": "0.25"
      },
      "secrets": {
        "required": [
          "SUPABASE_PUBLISHABLE_KEY",
          "ORIGIN_HMAC_SECRET",
          "IP_HASH_PEPPER"
        ]
      },
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "86083020",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "86083021",
          "simple": { "limit": 120, "period": 60 }
        }
      ]
    },
    "production": {
      "name": "sorita-edge-production",
      // Production ingress is deliberately fail-closed. Add the reviewed
      // custom route/domain before deployment; never expose a fallback
      // workers.dev hostname or invent a route in this repository.
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "BUILD_SHA": "0000000000000000000000000000000000000000",
        "ENVIRONMENT": "production",
        "SUPABASE_URL": "https://replace-production-project-ref.supabase.co",
        "SUPABASE_JWT_AUDIENCE": "authenticated",
        "CORS_ALLOWLIST": "https://app.sorita.invalid",
        "ORIGIN_TIMEOUT_MS": "8000",
        "JWKS_TIMEOUT_MS": "2500",
        "LOG_SAMPLE_RATE": "0.1"
      },
      "secrets": {
        "required": [
          "SUPABASE_PUBLISHABLE_KEY",
          "ORIGIN_HMAC_SECRET",
          "IP_HASH_PEPPER"
        ]
      },
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "86083030",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "86083031",
          "simple": { "limit": 120, "period": 60 }
        }
      ]
    }
  }
}
