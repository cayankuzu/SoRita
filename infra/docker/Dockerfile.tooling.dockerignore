# Deny the repository by default. Re-include only the explicit tooling inputs.
**
!.dockerignore
!package.json
!package-lock.json
!App.tsx
!app.config.ts
!index.js
!babel.config.cjs
!eslint.config.js
!knip.json
!metro.config.cjs
!tsconfig.json
!tsconfig.tests.json
!vitest.config.ts
!vitest.setup.ts
!eas.json
!assets/
!assets/**
!src/
!src/**
!supabase/
!supabase/config.toml
!supabase/seed.sql
!supabase/functions/
!supabase/functions/**
!supabase/migrations/
!supabase/migrations/**
!supabase/tests/
!supabase/tests/**
!quality/
!quality/**
!release-evidence/
!release-evidence/**
!docs/
!docs/**
!.github/
!.github/workflows/
!.github/workflows/**
!android/
!android/app/
!android/app/build.gradle
!android/app/src/
!android/app/src/main/
!android/app/src/main/AndroidManifest.xml
!android/app/src/main/res/
!android/app/src/main/res/values/
!android/app/src/main/res/values/strings.xml
!infra/
!infra/cloudflare/
!infra/cloudflare/sorita-edge/
!infra/cloudflare/sorita-edge/**
!infra/docker/
!infra/docker/**
!utils/
!utils/guards/
!utils/guards/check-docker-context.mjs
**/node_modules
**/node_modules/**
**/.wrangler
**/.wrangler/**
**/coverage
**/coverage/**
*.log

# Defense in depth: local/provider credentials are forbidden even below an
# allowlisted directory.
.env
.env.*
**/.dev.vars
**/.dev.vars.*
credentials.json
credentials/
*.p8
*.p12
*.pem
*.key
*.jks
*.keystore
*.mobileprovision
*service-account*.json
*firebase-admin*.json
google-services.json
GoogleService-Info.plist
android/app/google-services.json

# Native build and release artifacts never enter the tooling image.
*.aab
*.apk
*.ipa
