{
  "cli": {
    "version": ">= 18.5.0",
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "credentialsSource": "remote",
      "channel": "development",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "credentialsSource": "remote",
      "channel": "preview",
      "environment": "preview"
    },
    "production": {
      "distribution": "store",
      "autoIncrement": false,
      "credentialsSource": "remote",
      "channel": "production",
      "environment": "production",
      "env": {
        "EXPO_OWNER": "cayann"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6762198781",
        "appleTeamId": "HBRG8P523Z",
        "bundleIdentifier": "com.cayan.sorita.socialmap"
      }
    }
  }
}
